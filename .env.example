# Token del bot Telegram (da @BotFather)
BOT_API_KEY=123456789:token_del_bot

# Database Postgres (Neon) — connection string dalla console Neon
DATABASE_URL=postgresql://utente:password@host.neon.tech/neondb?sslmode=require

# URL pubblico della mini app
NEXT_PUBLIC_APP_URL=https://kart-gram.vercel.app/

# Better Auth (Autenticazione Dashboard)
BETTER_AUTH_SECRET=genera_una_stringa_segreta_casuale_di_32_caratteri
BETTER_AUTH_URL=https://kart-gram.vercel.app/
DASHBOARD_URL=https://dashboard-kartgram.vercel.app

# Backend usato dal gioco:
#   auto   -> remote dentro Telegram, mock nel browser del PC (default se vuoto)
#   mock   -> dati finti salvati in localStorage (sviluppo, nessun server richiesto)
#   remote -> API del gioco sul DB (/api/game)
NEXT_PUBLIC_BACKEND=auto

# URL base delle API del gioco (default /api/game, stesso dominio)
NEXT_PUBLIC_API_URL=/api/game

# Facoltativo: segreto passato a setWebhook (secret_token); se impostato il webhook accetta solo update di Telegram
TELEGRAM_WEBHOOK_SECRET=

# Solo per NEXT_PUBLIC_BACKEND=mock: monete iniziali per provare lo shop da PC.
# Nel mock gli acquisti in Stelle sono gratuiti: l'oggetto viene sbloccato subito, senza pagare.
# Per ripartire da zero: svuotare il localStorage del sito (DevTools > Application).
NEXT_PUBLIC_MOCK_COINS=5000
